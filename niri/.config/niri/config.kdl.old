// Main niri config. Split into modules under the same directory.
// https://niri-wm.github.io/niri/Configuration:-Introduction
// https://niri-wm.github.io/niri/Configuration:-Include

include "input.kdl"
include "outputs.kdl"
include "layout.kdl"
include "startup.kdl"
include "window-rules.kdl"
include "binds.kdl"

hotkey-overlay {
    // skip-at-startup
}

// prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
// screenshot-path null

animations {
    // off
    // slowdown 3.0
}

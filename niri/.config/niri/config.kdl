include "./cfg/autostart.kdl"

// spawn-at-startup "noctalia"
spawn-sh-at-startup "sh -c 'if command -v noctalia >/dev/null 2>&1; then exec noctalia; else exec noctalia-shell; fi'"

//spawn-at-startup "vicinae" "server"

//Workspaces do monitor 2
workspace "1" {
    open-on-output "HDMI-A-1"
}

workspace "2" {
    open-on-output "HDMI-A-1"
}

//Regra para abrir o Slack no monitor 2
window-rule {
    match app-id="slack"
    open-on-output "HDMI-A-1"
    open-on-workspace "1"
    open-maximized true
    //default-window-height { proportion 0.5; }
    //default-column-width { proportion 1.0; }
}

//Regra para abrir o Telegram no monitor 2
window-rule {
    match app-id="org.telegram.desktop"
    open-on-output "HDMI-A-1"
    open-on-workspace "2"
    open-maximized false
    default-window-height { proportion 0.5; }
    default-column-width { proportion 1.0; }
}

//Floating Preview
window-rule {
    match app-id="org.gnome.NautilusPreviewer"
    match app-id="qimgv"
    match app-id="mpv"
    open-floating true
    default-column-width { proportion 1.0; }
}


include "./cfg/keybinds.kdl"
  binds {
    
    //Abrir Vivaldi
    Mod+B { spawn "vivaldi"; }

    //Dividir a tela
    Mod+BracketLeft  { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }

    //Maximizar Tela
    Alt+M { maximize-column; }

    //Fullscreen
    Mod+F { fullscreen-window; }

    //Foco para a ESQUERDA
    Alt+A { focus-column-left; }
      
    //Foco para BAIXO
    Alt+S { focus-workspace-down; }
      
    //Foco para CIMA
    Alt+W { focus-workspace-up; }
      
    //Foco para a DIREITA
    Alt+D { focus-column-right; }

    //Abre/Fecha o launcher do Noctalia
    Alt+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    //Alt+Space repeat=false { spawn "vicinae" "toggle"; }

    //Fechar Janelas
    Alt+Q { close-window; }

    //Abre o plugin Clipper do Noctalia
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    //Centralizar Janela
    Alt+C { center-column; }

    //Ativa/Desativa o Desktop Widgets
    Alt+R { spawn-sh "qs -c noctalia-shell ipc call desktopWidgets toggle"; }

    // Abre o terminal Kitty com Win + Home
    Mod+Home { spawn "kitty"; }

    // Audio & Brightness
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }

    
}

include "./cfg/input.kdl"
    input {
    mouse {
    accel-speed -0.5
    scroll-method "on-button-down"
    scroll-button 274
    //accel-profile "flat"
         }

focus-follows-mouse max-scroll-amount="10%"
    keyboard{
    xkb {
    //Define o layout principal como US
    layout "us"
    //Define a variante
    variant "intl"
	}
	}
	
	}

include "./cfg/display.kdl"


